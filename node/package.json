{
  "name": "pro-sejongpeia",
  "version": "1.2.55",
  "description": "Sejong University integrated library for Node.js: portal login (SSO) and public school data (세종대 통합 라이브러리, 세종대 로그인 API)",
  "keywords": [
    "sejong",
    "sejong-university",
    "세종대",
    "authentication",
    "sso",
    "student-verification",
    "school-data",
    "courses",
    "curriculum",
    "academic-calendar",
    "세종대학교"
  ],
  "homepage": "https://cassiiopeia.github.io/pro-sejongpeia/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cassiiopeia/pro-sejongpeia.git",
    "directory": "node"
  },
  "bugs": "https://github.com/Cassiiopeia/pro-sejongpeia/issues",
  "license": "MIT",
  "author": "Suh Saechan",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/write-version.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
