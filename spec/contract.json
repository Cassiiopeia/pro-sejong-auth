{
  "_comment": "Single source for values shared by Java, Python and Node (login flow and school public-data requests). Each language has a test that compares its constants with this file. Change the value here first, then in every language.",
  "portal": {
    "loginUrl": "https://portal.sejong.ac.kr/jsp/login/login_action.jsp",
    "referer": "https://portal.sejong.ac.kr",
    "defaultCookie": "chknos=false",
    "loginAcceptedResult": "OK",
    "loginErrorCodeByResult": {
      "erridpwd": "AUTHENTICATION_FAILED",
      "Error": "AUTHENTICATION_FAILED",
      "pwdNeedChg": "ACCOUNT_LOCKED",
      "invalidDt": "ACCOUNT_UNAVAILABLE",
      "invalid": "ACCOUNT_UNAVAILABLE"
    }
  },
  "portalMain": {
    "url": "https://portal.sejong.ac.kr/user/index.do",
    "loginPageMarker": "login_action.jsp"
  },
  "classic": {
    "returnUrl": "classic.sejong.ac.kr",
    "ssoUrl": "https://classic.sejong.ac.kr/_custom/sejong/sso/sso-return.jsp?returnUrl=https://classic.sejong.ac.kr/classic/index.do",
    "statusUrl": "https://classic.sejong.ac.kr/classic/reading/status.do"
  },
  "sis": {
    "returnUrl": "sjpt.sejong.ac.kr/main/view/Login/doSsoLogin.do?p=",
    "ssoUrl": "https://sjpt.sejong.ac.kr/main/view/Login/doSsoLogin.do?p=",
    "userInfoUrl": "https://sjpt.sejong.ac.kr/main/sys/UserInfo/initUserInfo.do",
    "origin": "https://sjpt.sejong.ac.kr",
    "submitErrorKey": "_SUBMIT_ERROR_",
    "loggedOutErrorType": "LOGOUT",
    "extraExcludedKeyPattern": "(PWD|PASS|JUMIN|RRN|RESI|SSN|BANK|ACNT|ACCT|ACCOUNT|ADDR|ZIP|POST|ALIAS|SESS|TOKEN|SECRET|BIRTH|BRTH|VALID|PHONE|TEL|MOBILE|MAIL|LOGIN|RUNNING|(^|_)IP($|_)|_YN$)"
  },
  "sisSchedule": {
    "menuListUrl": "https://sjpt.sejong.ac.kr/main/view/Menu/doListUserMenuListLeft.do",
    "userRoleUrl": "https://sjpt.sejong.ac.kr/main/sys/UserRole/initUserRole.do",
    "listUrl": "https://sjpt.sejong.ac.kr/sch/sch/sud/SudBaseScheSelfServQ/doList.do",
    "programKey": "SELF_STUDSELF_SUB_20SELF_MENU_10SudBaseScheSelfServQ",
    "systemKey": "SCH",
    "menuSystemDiv": "SCH"
  },
  "publicData": {
    "_comment": "Login-free school sources (spec/PUBLIC_DATA.md). queryKeys and formKeys are the request parameter names in send order; urlTemplate marks the host part {siteId}.",
    "jsonAccept": "application/json",
    "formContentType": "application/x-www-form-urlencoded; charset=UTF-8",
    "formRequestedWith": "XMLHttpRequest",
    "sisTimetable": {
      "baseUrl": "https://sjpt.sejong.ac.kr/sch/sch/ext/SueOpenTimeQ/",
      "contentType": "application/json; charset=\"UTF-8\"",
      "searchKey": "dm_search",
      "onloadEndpoint": "doOnload.do",
      "termListEndpoint": "doYearsmtlist.do",
      "departmentListEndpoint": "doLesndeptgroup.do",
      "lectureListEndpoint": "doList.do",
      "lectureEmptyFilterKeys": ["SMT_NM", "CURI_TYPE_CD", "SLT_DOMAIN_CD", "CURI_NO", "CLASS", "SLT_DEPT_CD", "PLAN_REG_YN", "CORS_SCHE_GRP_CD"]
    },
    "curriculum": {
      "url": "https://www.sejong.ac.kr/curriculum/getCurriculumOneKor.do",
      "queryKeys": ["curiNo", "deptNo"]
    },
    "calendar": {
      "url": "https://www.sejong.ac.kr/kor/academics/academic-calendar.do",
      "queryKeys": ["mode", "start", "end", "collDiv"],
      "mode": "getCalendarData",
      "defaultCategoryCode": "0001"
    },
    "graduateCalendar": {
      "urlTemplate": "https://{siteId}.sejong.ac.kr/_custom/sejong/_app/calendar-graduate/proc/getCalendarData.jsp",
      "queryKeys": ["year", "month", "siteId"],
      "siteIdPattern": "[a-z0-9][a-z0-9-]{0,30}"
    },
    "dormitory": {
      "menuUrl": "https://happydorm.sejong.ac.kr/food/indexFoodList.do",
      "menuFormKeys": ["locgbn"],
      "noticeUrl": "https://happydorm.sejong.ac.kr/bbs/getBbsList.do",
      "noticeFormKeys": ["cPage", "rows", "bbs_locgbn", "bbs_id", "sType", "sWord"],
      "noticeBoardId": "notice",
      "noticeSearchType": "subject",
      "defaultLocation": "SJ"
    },
    "cafeteria": {
      "url": "https://www.sejong.ac.kr/kor/unilife/cafeteria-info.do",
      "queryKeys": ["mode", "placeId"],
      "menuMode": "getMenuList",
      "defaultMaxPlaceId": 10,
      "limitMaxPlaceId": 50
    },
    "campusMap": {
      "url": "https://www.sejong.ac.kr/kor/intro/campus-map.do",
      "queryKeys": ["mode", "placeType"],
      "mode": "getPlaceUserList"
    },
    "extracurricular": {
      "url": "https://do.sejong.ac.kr/ko/process/schedule/getEvents",
      "formKeys": ["cid", "category", "start", "end", "start_year", "end_year"],
      "cid": "eco"
    }
  },
  "opensslCiphers": "DEFAULT:AES256-SHA:@SECLEVEL=1",
  "errorMessageByCode": {
    "INVALID_INPUT": "Invalid input.",
    "AUTHENTICATION_FAILED": "Sejong University portal authentication failed. Check the student ID and password.",
    "CONNECTION_FAILED": "Cannot connect to the Sejong University portal.",
    "CONNECTION_TIMEOUT": "Connection to the Sejong University portal timed out.",
    "SESSION_ERROR": "An error occurred while handling the portal session.",
    "DATA_FETCH_FAILED": "Failed to fetch student information.",
    "PARSE_ERROR": "Failed to parse student information.",
    "SSL_CONFIGURATION_ERROR": "Failed to configure SSL.",
    "ACCOUNT_LOCKED": "The portal account is locked after too many wrong passwords. Reset the password at https://portal.sejong.ac.kr/jsp/inquiry/pwinquiry.jsp",
    "ACCOUNT_UNAVAILABLE": "The portal account cannot sign in (use period ended or blocked by the administrator)."
  }
}
